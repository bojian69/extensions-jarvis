{
  "manifest_version": 3,
  "name": "AI申请助手",
  "version": "1.0",
  "description": "自动化申请助手",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.js",
        "form-filler.js", 
        "form-configs/*.js",
        "status-window/*.html",
        "status-window/*.css",
        "status-window/*.js",
        "data-collectors/*.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI申请助手"
  }
}